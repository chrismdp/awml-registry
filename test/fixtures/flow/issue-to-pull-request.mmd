  label@{ shape: notch-rect, label: "Only people with write access and the repository#39;s app can add a label#44; and GitHub holds that#44; not a prompt#44; so a stranger#39;s comment starts nothing#46; The draft step#39;s token can only read#44; so it can#39;t push #40;awml #35;26#41;" }
  subgraph public["public#58; anyone who reads the repository"]
    direction TB
    comment(["The build label is added to an issue"])
    dispatch(["A failed try starts the build again"])
    token{{"The repository#44; through its own Actions token"}}
    app{{"The repository#44; through its own GitHub App"}}
    who("<small style='color:rgb(61,67,79)'>⚙️ 🗂️ sort</small><br>Sort by rule#58; is the label build#63;")
    started("<small style='color:rgb(61,67,79)'>⚙️ 🛠️ do</small><br>Post the build#39;s status comment on the issue#44; or on a retry edit it with the try and why the last one failed")
    status>"Post or edit the build#39;s status comment#58; Allow"]
    bring("<small style='color:rgb(61,67,79)'>⚙️ 📥 bring-in</small><br>Bring in the issue and the comments of the repository#39;s own people")
    repo[("The spec#44; guide#44; code#44; AGENTS#46;md and REVIEW#46;md#44; which says what failure looks like here")]
    failed[("Why the last try failed")]
    build("<small style='color:rgb(61,67,79)'>🤖 ✏️ draft</small><br>Write the change test first#44; then redraw the examples it alters and picture#44; before and after#44; those that look different")
    patch[("The change#44; as a patch#44; with its pictures#44; Claude#39;s note and its description for the pull request")]
    gate("<small style='color:rgb(61,67,79)'>⚙️ 🔍 check</small><br>Run the tests#44; vet#44; the examples and wasm parity")
    review("<small style='color:rgb(61,67,79)'>🤖 🔍 check</small><br>Review the patch for bugs#44; with fresh context#44; keeping only the findings that survive a second look")
    secreview("<small style='color:rgb(61,67,79)'>🤖 🔍 check</small><br>Review the patch for security#44; in a separate session#44; alongside the bug review")
    weigh("<small style='color:rgb(61,67,79)'>⚙️ 🗂️ sort</small><br>Once both reviews are done#44; sort their findings by rule#58; is one Important#44; and is this the third try#63;")
    findings[("The reviews#39; findings#44; each Important#44; Nit or Pre#45;existing")]
    classify("<small style='color:rgb(61,67,79)'>🤖 🗂️ sort</small><br>Sort by risk#58; does a person need to look at this change#63;")
    risk[("The classifier#39;s verdict and its reasons")]
    open("<small style='color:rgb(61,67,79)'>⚙️ 🛠️ do</small><br>Push the branch and the pictures#44; and open a pull request that closes the issue")
    pr>"Push the branch and pictures#44; and open the pull request#58; Allow"]
    tryfailed(["A try failed"])
    pushed(["The app pushes the pull request#39;s branch"])
    strangers@{ shape: notch-rect, label: "Anyone can comment#44; but the bring#45;in step passes on only the comments of the owner#44; members and collaborators#44; so strangers#39; text never reaches the draft step#46; AWML can#39;t mark this yet #40;awml #35;5#41;" }
    verdict@{ shape: notch-rect, label: "The checks run where the draft step can#39;t reach#44; and their verdict is in their own record #40;awml #35;13#44; #35;20#41;" }
    seen@{ shape: notch-rect, label: "Only a change to what a drawing or a page shows is pictured#44; and a picture that looks the same before and after is left out#46; A moving image only for something that moves" }
    fresh@{ shape: notch-rect, label: "The reviewers and the classifier never see the drafting session#44; and read the patch#44; not the issue#39;s thread#46; Their read#45;only token can#39;t push#44; comment or merge" }
    layout@{ shape: notch-rect, label: "The description opens with the classifier#39;s reasons and any open findings#44; then Claude#39;s note as written#44; then what changed#44; the decisions the issue didn#39;t settle#44; the pictures#44; and the issue it closes" }
    onecomment@{ shape: notch-rect, label: "One status comment per build#46; It carries a hidden marker#44; so a retry finds it again without passing anything between runs" }
    starts@{ shape: notch-rect, label: "GitHub starts other workflows from the app#39;s pushes#44; merges and labels#44; but not from the Actions token#39;s#44; so CI runs on the pull request" }
  end

