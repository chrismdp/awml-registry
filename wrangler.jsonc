{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awml-registry",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext's self-reference; the service name must match the worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "awml-registry"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "awml-registry",
      // Local development needs no real id. A deploy needs the id from `wrangler d1 create`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  // Cloudflare Email Service sends the sign-in links. It needs the sending
  // domain onboarded in the Cloudflare account first.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "MAIL_FROM": "AWML <login@awml.io>"
  }
}
