{
  "$schema": "node_modules/wrangler/config-schema.json",
  // To run your own registry on Cloudflare, fill in the four places marked
  // "Yours:" below. The README's "Run it on Cloudflare" says how.
  "name": "awml-registry",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext's self-reference; the service name must match the worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "awml-registry"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "awml-registry",
      // Yours: the id `npx wrangler d1 create awml-registry` prints. Local
      // preview and `npm run cf:migrate:local` work without it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  // Cloudflare Email Service sends the sign-in links. It needs the sending
  // domain onboarded in the Cloudflare account first.
  "send_email": [{ "name": "EMAIL" }],
  // Yours, if you like: serve the registry at your own domain rather than on
  // workers.dev, with a route on a zone in your Cloudflare account, such as
  // "routes": [{ "pattern": "registry.example.com/*", "zone_name": "example.com" }],
  "vars": {
    // Yours: the address people reach the registry at. Local preview
    // overrides it with http://localhost:8787 in .dev.vars.
    "BETTER_AUTH_URL": "https://registry.example.com",
    // Yours: who sign-in emails come from, at a domain onboarded for sending.
    "MAIL_FROM": "Registry <login@example.com>"
  }
}
