    "@modelcontextprotocol/server": "^2.3.1",
    "@xyflow/react": "^12.12.0",
    "better-auth": "^1.7.12",
    "better-sqlite3": "^13.0.3",
    "d3-force": "^3.0.0",
    "drizzle-orm": "^0.45.4",
    "elkjs": "^0.12.0",
    "jose": "^6.2.13",
    "markdown-it": "^14.1.0",
    "mermaid": "11.17.2",
    "next": "^16.4.2",
    "nodemailer": "^10.1.7",
